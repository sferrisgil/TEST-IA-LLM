# Clave del proveedor de IA (Gemini). Sin ella la plataforma arranca en modo demostración.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Modelos (opcional)
# GEMINI_MODEL="gemini-3.1-pro-preview"
# GEMINI_FAST_MODEL="gemini-3.1-pro-preview"

# Correo del Delegado de Protección de Datos (opcional)
# DPD_EMAIL="dpd@ayuntamiento.es"

# URL donde se aloja la aplicación
APP_URL="MY_APP_URL"

# --- Servidor interno (ver docs/despliegue.md) ---
# DATA_DIR="/var/lib/taller-apps"
# AUTH_MODE="proxy"
# TRUSTED_PROXIES="127.0.0.1/32"
# INTERNAL_NETWORKS="10.0.0.0/8,10.200.0.0/16"
# GROUP_STAFF="plantilla"
# GROUP_CONTRACTOR="contratas"
# GROUP_REVIEWER="revisores-apps"

# --- Modelos de IA (ver config/modelos.ejemplo.json) ---
# MODELS_FILE="config/modelos.json"
# LOCAL_MODEL_URL="http://ia.intranet.ayto.local:8000/v1"
# LOCAL_MODEL="nombre-del-modelo-local"
